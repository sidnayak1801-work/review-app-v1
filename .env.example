# Neon pooled connection used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Neon direct connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional isolated database used by repository integration tests.
TEST_DATABASE_URL=""

# Supplied automatically by `shopify app dev` during local development.
# Coolify / production: SHOPIFY_APP_URL=https://reviewtrixapp.algorithmtrix.com
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""
SCOPES="read_orders,read_products,read_themes"

# Use Shopify test charges for billing.
# Local / staging: true (or omit outside production — defaults to test).
# Coolify / App Store production: BILLING_TEST_MODE=false
BILLING_TEST_MODE=true

# Optional review-request / lifecycle email provider (Resend). Without these, emails log to console.
RESEND_API_KEY=""
EMAIL_FROM="Review App <reviews@example.com>"

# Shared secret for POST /internal/process-lifecycle-emails (Coolify cron).
# Required for the internal route; generate a long random string.
INTERNAL_JOB_SECRET=""

# AWS S3 (or S3-compatible e.g. Cloudflare R2) for production media.
# Optional in local development — without these, files are stored under
# storage/media and served from /api/media/*.
# AWS example:
#   MEDIA_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
#   MEDIA_S3_REGION=ap-south-1
#   MEDIA_PUBLIC_BASE_URL=https://your-bucket.s3.ap-south-1.amazonaws.com
#     (or your CloudFront domain)
# R2: use your account endpoint and MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=""
MEDIA_S3_ENDPOINT=""
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_BASE_URL=""
MEDIA_S3_REGION="ap-south-1"

# AES-256-GCM key for encrypting third-party integration credentials at rest.
# 32 bytes as 64 hex characters, or standard base64 encoding of 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPTION_KEY=""
