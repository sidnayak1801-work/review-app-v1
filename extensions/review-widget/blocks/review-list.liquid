{% liquid
  assign product_resource = closest.product
  if product_resource == blank
    assign product_resource = product
  endif

  assign customer_logged_in = false
  assign customer_name = ''
  assign customer_email = ''
  assign customer_id = ''

  if customer
    assign customer_logged_in = true
    assign customer_id = customer.id
    assign customer_email = customer.email
    if customer.name != blank
      assign customer_name = customer.name
    elsif customer.first_name != blank or customer.last_name != blank
      assign customer_name = customer.first_name | append: ' ' | append: customer.last_name | strip
    else
      assign customer_name = 'Customer'
    endif
  endif
%}

{% if product_resource %}
  <div
    class="vouch-reviews"
    data-vouch-reviews
    data-product-id="{{ product_resource.id }}"
    data-proxy-url="/apps/reviews"
    data-show-form="{{ block.settings.show_form }}"
    data-customer-logged-in="{% if customer_logged_in %}true{% else %}false{% endif %}"
    {% if customer_logged_in %}
      data-customer-id="{{ customer_id }}"
      data-customer-name="{{ customer_name | escape }}"
      data-customer-email="{{ customer_email | escape }}"
    {% endif %}
    style="--vouch-accent: {{ block.settings.accent_color }};"
    {{ block.shopify_attributes }}
  >
    <h2 class="vouch-reviews__heading">{{ block.settings.heading }}</h2>
    <div class="vouch-reviews__list" data-vouch-reviews-list>
      Loading reviews…
    </div>

    <div class="vouch-reviews__guest" data-vouch-reviews-guest hidden>
      <button type="button" class="vouch-reviews__write-btn" data-vouch-open-auth>
        Write a review
      </button>
    </div>

    <div class="vouch-reviews__form-wrap" data-vouch-reviews-form hidden>
      <h3>Write a review</h3>
      <form data-vouch-review-form>
        <fieldset class="vouch-reviews__rating">
          <legend>Your rating</legend>
          <input type="hidden" name="rating" value="" required data-vouch-rating-input />
          <div class="vouch-reviews__star-picker-row">
            <div
              class="vouch-reviews__star-picker"
              data-vouch-star-picker
              role="radiogroup"
              aria-label="Rating"
              aria-required="true"
            >
              <button type="button" class="vouch-reviews__star-btn" data-rating="1" aria-label="1 star">★</button>
              <button type="button" class="vouch-reviews__star-btn" data-rating="2" aria-label="2 stars">★</button>
              <button type="button" class="vouch-reviews__star-btn" data-rating="3" aria-label="3 stars">★</button>
              <button type="button" class="vouch-reviews__star-btn" data-rating="4" aria-label="4 stars">★</button>
              <button type="button" class="vouch-reviews__star-btn" data-rating="5" aria-label="5 stars">★</button>
            </div>
            <span class="vouch-reviews__rating-value" data-vouch-rating-display aria-live="polite"></span>
          </div>
        </fieldset>
        <label>
          Title
          <input type="text" name="title" maxlength="200" />
        </label>
        <label>
          Review
          <textarea name="body" required maxlength="5000"></textarea>
        </label>
        <p class="vouch-reviews__author">
          Reviewing as <strong data-vouch-author-display>{{ customer_name | escape }}</strong>
        </p>
        <input type="hidden" name="authorName" value="{{ customer_name | escape }}" data-vouch-author-name />
        <input type="hidden" name="authorEmail" value="{{ customer_email | escape }}" data-vouch-author-email />
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="vouch-reviews__honeypot" aria-hidden="true" />
        <button type="submit" class="vouch-reviews__submit">Submit review</button>
      </form>
      <p class="vouch-reviews__message" data-vouch-review-message hidden></p>
    </div>

    <div
      class="vouch-auth-wall"
      data-vouch-auth-wall
      hidden
      role="dialog"
      aria-modal="true"
      aria-labelledby="vouch-auth-wall-title"
    >
      <div class="vouch-auth-wall__backdrop" data-vouch-close-auth></div>
      <div class="vouch-auth-wall__panel">
        <button
          type="button"
          class="vouch-auth-wall__close"
          data-vouch-close-auth
          aria-label="Close"
        >
          ×
        </button>
        <h3 id="vouch-auth-wall-title" class="vouch-auth-wall__title">
          Sign in to leave a review
        </h3>
        <p class="vouch-auth-wall__body">
          Create an account or log in so we can attribute your review to you.
        </p>
        <a
          class="vouch-auth-wall__signup"
          href="{{ routes.account_register_url }}"
          target="_top"
          rel="nofollow"
        >
          Sign up
        </a>
        <a
          class="vouch-auth-wall__login"
          href="{{ routes.storefront_login_url }}"
          target="_top"
          rel="nofollow"
        >
          Log in
        </a>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product reviews",
  "target": "section",
  "stylesheet": "review-widget.css",
  "javascript": "review-widget.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show submission form",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#111111"
    }
  ]
}
{% endschema %}
