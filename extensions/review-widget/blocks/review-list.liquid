{% liquid
  assign product_resource = closest.product
  if product_resource == blank
    assign product_resource = product
  endif

  assign customer_name = ''
  assign customer_email = ''

  if customer
    assign customer_email = customer.email
    if customer.name != blank
      assign customer_name = customer.name
    elsif customer.first_name != blank or customer.last_name != blank
      assign customer_name = customer.first_name | append: ' ' | append: customer.last_name | strip
    endif
  endif
%}

{% if product_resource %}
  <div
    class="vouch-reviews"
    data-vouch-reviews
    data-product-id="{{ product_resource.id }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-product-image="{% if product_resource.featured_image %}{{ product_resource.featured_image | image_url: width: 120 }}{% endif %}"
    data-proxy-url="/apps/reviews"
    data-show-form="{{ block.settings.show_form }}"
    data-page-size="5"
    style="--vouch-accent: {{ block.settings.accent_color }}; --vouch-star-fill: #22c55e;"
    {{ block.shopify_attributes }}
  >
    <div class="vouch-reviews__header">
      <div class="vouch-reviews__header-main">
        <h2 class="vouch-reviews__heading">{{ block.settings.heading }}</h2>
        <div class="vouch-reviews__summary" data-vouch-summary hidden>
          <span class="vouch-reviews__summary-stars" data-vouch-summary-stars></span>
          <span class="vouch-reviews__summary-avg" data-vouch-summary-avg></span>
          <span class="vouch-reviews__summary-count" data-vouch-summary-count></span>
        </div>
      </div>
      <button
        type="button"
        class="vouch-reviews__write-btn"
        data-vouch-open-modal
        {% if block.settings.show_form == false %}hidden{% endif %}
      >
        Write a review
      </button>
    </div>

    <div class="vouch-reviews__list" data-vouch-reviews-list>
      Loading reviews…
    </div>
    <button type="button" class="vouch-reviews__load-more" data-vouch-load-more hidden>
      Load more reviews
    </button>

    <div
      class="vouch-modal"
      data-vouch-modal
      hidden
      role="dialog"
      aria-modal="true"
      aria-labelledby="vouch-modal-title"
    >
      <div class="vouch-modal__backdrop" data-vouch-close-modal></div>
      <div class="vouch-modal__panel">
        <button type="button" class="vouch-modal__close" data-vouch-close-modal aria-label="Close">
          ×
        </button>

        <form class="vouch-modal__form" data-vouch-review-form>
          <input type="hidden" name="rating" value="" data-vouch-rating-input />
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="vouch-reviews__honeypot" aria-hidden="true" />

          <div class="vouch-modal__steps" data-vouch-steps>
            <section class="vouch-modal__step is-active" data-vouch-step="0">
              <h3 id="vouch-modal-title" class="vouch-modal__title">How would you rate this product?</h3>
              <p class="vouch-modal__sub">We would love it if you would share a bit about your experience.</p>
              <p class="vouch-modal__product" data-vouch-modal-product>{{ product_resource.title | escape }}</p>
              <div
                class="vouch-modal__star-picker"
                data-vouch-star-picker
                role="radiogroup"
                aria-label="Rating"
              >
                <button type="button" class="vouch-modal__star-btn" data-rating="1" aria-label="1 star">★</button>
                <button type="button" class="vouch-modal__star-btn" data-rating="2" aria-label="2 stars">★</button>
                <button type="button" class="vouch-modal__star-btn" data-rating="3" aria-label="3 stars">★</button>
                <button type="button" class="vouch-modal__star-btn" data-rating="4" aria-label="4 stars">★</button>
                <button type="button" class="vouch-modal__star-btn" data-rating="5" aria-label="5 stars">★</button>
              </div>
              <div class="vouch-modal__star-labels">
                <span>Poor</span>
                <span>Great</span>
              </div>
            </section>

            <section class="vouch-modal__step" data-vouch-step="1" hidden>
              <h3 class="vouch-modal__title">{{ product_resource.title | escape }}</h3>
              <div class="vouch-modal__step-stars" data-vouch-step-stars aria-hidden="true"></div>
              <label class="vouch-modal__label">
                Title
                <input type="text" name="title" maxlength="200" placeholder="Summarize your experience" />
              </label>
              <label class="vouch-modal__label">
                Review content (Required)
                <textarea name="body" required maxlength="5000" rows="5" placeholder="What did you like or dislike?"></textarea>
              </label>
            </section>

            <section class="vouch-modal__step" data-vouch-step="2" hidden>
              <h3 class="vouch-modal__title">Add photos or video</h3>
              <p class="vouch-modal__sub">Optional — up to 5 photos and 1 video (max 10 MB each).</p>
              <div class="vouch-modal__media" data-vouch-media>
                <label class="vouch-modal__media-add">
                  <span>+ Add</span>
                  <input
                    type="file"
                    accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime"
                    multiple
                    data-vouch-media-input
                    hidden
                  />
                </label>
                <div class="vouch-modal__media-grid" data-vouch-media-grid></div>
              </div>
              <p class="vouch-modal__hint">JPEG, PNG, WebP, GIF, MP4, WebM, MOV — max 10 MB each.</p>
            </section>

            <section class="vouch-modal__step" data-vouch-step="3" hidden>
              <h3 class="vouch-modal__title">About you</h3>
              <p class="vouch-modal__sub">Please tell us more about you.</p>
              <label class="vouch-modal__label">
                Display name (Required)
                <input
                  type="text"
                  name="authorName"
                  required
                  maxlength="100"
                  value="{{ customer_name | escape }}"
                  placeholder="Your name"
                />
              </label>
              <label class="vouch-modal__label">
                Email address (optional)
                <input
                  type="email"
                  name="authorEmail"
                  value="{{ customer_email | escape }}"
                  placeholder="you@example.com"
                />
              </label>
              <p class="vouch-modal__hint">We respect your privacy.</p>
            </section>

            <section class="vouch-modal__step" data-vouch-step="4" hidden>
              <h3 class="vouch-modal__title">Thanks for your review!</h3>
              <p class="vouch-modal__sub">
                We are processing it and it will appear on the store once approved.
              </p>
            </section>
          </div>

          <p class="vouch-modal__error" data-vouch-modal-error hidden></p>

          <div class="vouch-modal__footer" data-vouch-modal-footer>
            <button type="button" class="vouch-modal__back" data-vouch-back hidden>← Back</button>
            <button type="button" class="vouch-modal__next" data-vouch-next>Next</button>
            <button type="button" class="vouch-modal__done" data-vouch-close-modal hidden>Close</button>
          </div>
        </form>
      </div>
    </div>

    <div
      class="vouch-lightbox"
      data-vouch-lightbox
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="Review media"
    >
      <div class="vouch-lightbox__backdrop" data-vouch-lb-close></div>
      <div class="vouch-lightbox__panel">
        <button
          type="button"
          class="vouch-lightbox__close"
          data-vouch-lb-close
          aria-label="Close"
        >
          ×
        </button>
        <button
          type="button"
          class="vouch-lightbox__nav vouch-lightbox__nav--prev"
          data-vouch-lb-prev
          aria-label="Previous"
          hidden
        >
          ‹
        </button>
        <div class="vouch-lightbox__stage" data-vouch-lb-stage></div>
        <button
          type="button"
          class="vouch-lightbox__nav vouch-lightbox__nav--next"
          data-vouch-lb-next
          aria-label="Next"
          hidden
        >
          ›
        </button>
        <p class="vouch-lightbox__counter" data-vouch-lb-counter hidden></p>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product reviews",
  "target": "section",
  "stylesheet": "review-widget.css",
  "javascript": "review-widget.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show submission form",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0f766e"
    }
  ]
}
{% endschema %}
