// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ShopPlan {
  FREE
  PRO
}

enum ShopStatus {
  INSTALLED
  UNINSTALLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewSource {
  STOREFRONT
  MERCHANT
  IMPORT
}

enum ReviewImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewRequestStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
  COMPLETED
}

model Shop {
  id             String          @id @default(cuid())
  shopDomain     String          @unique
  shopifyShopId  String?         @unique
  plan           ShopPlan        @default(FREE)
  status         ShopStatus      @default(INSTALLED)
  installedAt    DateTime        @default(now())
  uninstalledAt  DateTime?
  billingStatus  String?
  billingSyncedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  reviews        Review[]
  reviewImports  ReviewImport[]
  reviewRequests ReviewRequest[]
  widgetSettings WidgetSettings?
  reviewRequestSettings ReviewRequestSettings?

  @@index([status])
}

model Review {
  id                String       @id @default(cuid())
  shopId            String
  shop              Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyProductId  String
  shopifyCustomerId String?
  rating            Int
  title             String?
  body              String
  authorName        String
  authorEmail       String?
  status            ReviewStatus @default(PENDING)
  source            ReviewSource
  verifiedPurchase  Boolean      @default(false)
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([shopId, status, createdAt])
  @@index([shopId, shopifyProductId, status, createdAt])
}

model ReviewImport {
  id           String             @id @default(cuid())
  shopId       String
  shop         Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status       ReviewImportStatus @default(PENDING)
  fileKey      String
  contentHash  String?
  totalRows    Int                @default(0)
  importedRows Int                @default(0)
  failedRows   Int                @default(0)
  errorFileKey String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([shopId, contentHash])
  @@index([shopId, createdAt])
}

model ReviewRequest {
  id                  String              @id @default(cuid())
  shopId              String
  shop                Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyOrderId      String
  shopifyProductId    String
  customerEmail       String
  status              ReviewRequestStatus @default(SCHEDULED)
  scheduledAt         DateTime
  sentAt              DateTime?
  reminderSentAt      DateTime?
  attemptCount        Int                 @default(0)
  lastErrorCode       String?
  submissionTokenHash String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([shopId, shopifyOrderId, shopifyProductId])
  @@index([status, scheduledAt])
  @@index([shopId, createdAt])
  @@index([shopId, shopifyOrderId, status])
}

model ReviewRequestSettings {
  id                      String   @id @default(cuid())
  shopId                  String   @unique
  shop                    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  requestDelayDays        Int      @default(3)
  domesticDelayDays       Int      @default(3)
  internationalDelayDays  Int      @default(3)
  homeCountryCode         String   @default("US")
  emailSubject            String   @default("How was your purchase?")
  emailBodyHtml           String   @default("")
  reminderEnabled         Boolean  @default(true)
  reminderDelayDays       Int      @default(7)
  reminderSubject         String   @default("Reminder: share your review")
  reminderBodyHtml        String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model WidgetSettings {
  id             String   @id @default(cuid())
  shopId         String   @unique
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  accentColor    String   @default("#111111")
  showReviewForm Boolean  @default(true)
  reviewsPerPage Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
