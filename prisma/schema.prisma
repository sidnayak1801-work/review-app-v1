// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ShopPlan {
  FREE
}

enum ShopStatus {
  INSTALLED
  UNINSTALLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewSource {
  STOREFRONT
  MERCHANT
  IMPORT
}

model Shop {
  id             String          @id @default(cuid())
  shopDomain     String          @unique
  shopifyShopId  String?         @unique
  plan           ShopPlan        @default(FREE)
  status         ShopStatus      @default(INSTALLED)
  installedAt    DateTime        @default(now())
  uninstalledAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  reviews        Review[]
  widgetSettings WidgetSettings?

  @@index([status])
}

model Review {
  id                String       @id @default(cuid())
  shopId            String
  shop              Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyProductId  String
  shopifyCustomerId String?
  rating            Int
  title             String?
  body              String
  authorName        String
  authorEmail       String?
  status            ReviewStatus @default(PENDING)
  source            ReviewSource
  verifiedPurchase  Boolean      @default(false)
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([shopId, status, createdAt])
  @@index([shopId, shopifyProductId, status, createdAt])
}

model WidgetSettings {
  id             String   @id @default(cuid())
  shopId         String   @unique
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  accentColor    String   @default("#111111")
  showReviewForm Boolean  @default(true)
  reviewsPerPage Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
